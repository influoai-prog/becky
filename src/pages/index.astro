---
const title = "becky | home";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" type="image/png" href="/favicon.png" />
    <style>
      :global(*) { box-sizing: border-box; }
      :global(body) { margin: 0; min-height: 100vh; display: grid; place-items: center; font-family: Arial, sans-serif; background: #f7f6f2; color: #151515; }
      main { width: min(680px, calc(100% - 40px)); padding: 64px 40px; border: 2px solid #151515; border-radius: 24px; background: #fff0a8; box-shadow: 8px 8px 0 #151515; }
      h1 { margin: 0 0 12px; font-size: clamp(2.4rem, 8vw, 5rem); letter-spacing: -.07em; }
      p { margin: 0 0 28px; font-size: 1.15rem; }
      a { display: inline-block; padding: 14px 20px; border: 2px solid #151515; border-radius: 999px; color: inherit; font-weight: 700; text-decoration: none; background: white; }
    </style>
  </head>
  <body>
    <main>
      <h1>becky | home</h1>
      <p>This is a placeholder webpage. More coming soon.</p>
      <a href="/creators">Create with Becky →</a>
    </main>
  </body>
</html>
